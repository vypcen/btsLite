{
  "name": "blackcat-testing-lite",
  "version": "1.1.0",
  "private": true,
  "description": "BlackCat Testing Lite — система управления тестированием: тест-кейсы, прогоны, баги",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "migrate": "node server/migrate.js",
    "import": "node scripts/import.js",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "test:unit": "node --test test/unit.test.js",
    "lint": "eslint .",
    "typecheck": "npm --prefix web run typecheck",
    "check": "npm run lint && npm run typecheck && npm test",
    "e2e": "npm run build:web && playwright test -c e2e/playwright.config.js",
    "build:dist": "node scripts/build-dist.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "marked": "^15.0.12",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "javascript-obfuscator": "^4.2.2"
  }
}
