<service>
  <id>BlackCatTestingCommunity</id>
  <name>BlackCat Testing Community</name>
  <description>BlackCat Testing Community test management</description>
  <executable>%BASE%\node.exe</executable>
  <arguments>--env-file="%ProgramData%\BlackCatTestingCommunity\app.env" server\index.js</arguments>
  <workingdirectory>%BASE%\app</workingdirectory>
  <depend>BlackCatTestingCommunityDb</depend>
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
  </serviceaccount>
  <startmode>Automatic</startmode>
  <logpath>%ProgramData%\BlackCatTestingCommunity\logs</logpath>
  <log mode="roll"></log>
  <onfailure action="restart" delay="10 sec"/>
</service>
